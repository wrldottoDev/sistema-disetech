# Never put real credentials in this file. Copy to .env.local for development.
DATABASE_URL=postgres://disetech_app:change-me@127.0.0.1:5432/disetech_dev
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUDIT_HMAC_SECRET=replace-with-a-different-32-char-secret

# Email. Development: "memory" (nothing is sent). Production MUST use "smtp".
EMAIL_TRANSPORT=memory
EMAIL_FROM=info@disetechcr.com
# Production Zoho SMTP only (port 465 = implicit TLS):
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_USER=info@disetechcr.com
# SMTP_PASSWORD=

# Production only: required secret that must be typed in /inicializar to create the first Admin.
# BOOTSTRAP_TOKEN=replace-with-a-random-string-of-16-or-more-characters

# Where generated quotation PDFs are stored (LOCAL_FS). Use a persistent, backed-up volume in production.
# DOCUMENT_STORAGE_DIR=/var/lib/disetech/documents

ENABLE_TEST_ENDPOINTS=false
